{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "nexus/frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/css/(.*)",
      "dest": "/nexus/frontend/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/nexus/frontend/js/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/nexus/frontend/$1"
    }
  ]
}
